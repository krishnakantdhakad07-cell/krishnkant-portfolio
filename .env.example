# ==========================================
# 🚀 PORTFOLIO LEAD NOTIFICATIONS SETUP
# ==========================================

# 1. 📱 TELEGRAM BOT SETUP (Instant phone alerts)
# Steps:
# a) Telegram par @BotFather search karein aur /newbot banayein -> aapko Token milega.
# b) Telegram par @userinfobot search karein -> aapko apna Chat ID milega.
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# 2. 📊 GOOGLE SHEETS SETUP (All leads saved in Excel)
# Steps:
# a) Google Sheets kholein aur Extensions -> Apps Script par click karein.
# b) Code paste karke 'Deploy as Web App' karein aur URL yahan dalein.
GOOGLE_SHEET_WEBHOOK="your_google_apps_script_url_here"
